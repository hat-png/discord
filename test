uiConnect(RunService.RenderStepped, function()
	if not (drag or DragSlider) then return end
	local ok, touches = pcall(function() return UIS:GetTouchInputs() end)
	if ok and touches and touches then
		moveDrag(pos2(touches))
	elseif ok then
		stopDrag()
	end
end)

