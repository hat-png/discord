-- DeltaRhythm Autoplayer - performance-tuned rewrite
--  * Single scheduler task instead of one task per note (fixes lag on dense charts)
--  * Lane geometry + key bindings cached (fewer layout reads / tree walks)
--  * Per-frame work budget, late-press guard, catch-up grace
--  * New: Offset slider, Auto mode, Stats HUD + Reset, live key readout
--  * Fixed: relAll() never actually released keys (wrong argument order)

local G = (getgenv and getgenv()) or _G

if G.DeltaRhythmAutoplayer and type(G.DeltaRhythmAutoplayer.Unload) == "function" then
	pcall(G.DeltaRhythmAutoplayer.Unload)
end

local L = loadstring or load
assert(type(L) == "function", "loadstring/load unavailable")

local HAS_FIRESIGNAL = type(firesignal) == "function"

