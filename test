local R = cloneref or function(v) return v end

local Players = SR.cs("Players", R)
local RunService = SR.cs("RunService", R)
local VIM = SR.cs("VirtualInputManager", R)
local UIS = SR.cs("UserInputService", R)

local lp = Players.LocalPlayer
local sg = lp:WaitForChild("PlayerGui"):WaitForChild("ScreenGui")
local gf = sg:WaitForChild("GAMEFRAME")
local you = gf:WaitForChild("YOU")
local mobile = sg:WaitForChild("Mobile")
local binds = sg:WaitForChild("SETTI"):WaitForChild("ScrollingFrame"):WaitForChild("Keybinds")

local AP = {
	Enabled = false,
	Mode = "Virtual Input",
	TapRelease = 0.035,    -- seconds to hold a tap note
	Offset = 0,            -- NEW: timing calibration in px (+ = later, - = earlier)
	Auto = false,          -- NEW: auto enable/disable with the song
	AutoIdle = 2.5,        -- NEW: idle seconds before auto-off
	MaxPerFrame = 256,     -- NEW: scheduler work budget per frame (anti-lag)
	PastTol = 20,          -- NEW: px past the line we still press (catch-up grace)
	Generation = 0,
	Unloaded = false,
	Connections = {},
	Bound = setmetatable({}, { __mode = "k" }),
	ContainerConnections = setmetatable({}, { __mode = "k" }),
	Tokens = setmetatable({}, { __mode = "k" }),
	ActiveLanes = {},
	FourKey = true,
	PC = nil,
	Signals = 0,           -- NEW: note-spawn counter (drives Auto mode)
	LastSignalAt = 0,      -- NEW
	Stats = {
		Lanes = 0, Containers = 0, Notes = 0, ReusedNotes = 0, TapNotes = 0,
		HoldNotes = 0, Presses = 0, Releases = 0, InputFailures = 0, ExpiredUnpressed = 0,
	},
}
G.DeltaRhythmAutoplayer = AP

local LF = { L2 = "Lane_L2", L = "Lane_L", R = "Lane_R", R2 = "Lane_R2" }
local FL = { Lane_L2 = "L2", Lane_L = "L", Lane_R = "R", Lane_R2 = "R2" }

local function cn(s, f)
	local c = s:Connect(f)
	AP.Connections[#AP.Connections + 1] = c
	return c
end

local function norm(s)
	return string.lower(tostring(s or "")):gsub("[%s_%-]", "")
end

local KN = {}
for _, k in ipairs(Enum.KeyCode:GetEnumItems()) do
	KN[norm(k.Name)] = k
end

local DA = {
	["0"] = Enum.KeyCode.Zero, ["1"] = Enum.KeyCode.One, ["2"] = Enum.KeyCode.Two,
	["3"] = Enum.KeyCode.Three, ["4"] = Enum.KeyCode.Four, ["5"] = Enum.KeyCode.Five,
	["6"] = Enum.KeyCode.Six, ["7"] = Enum.KeyCode.Seven, ["8"] = Enum.KeyCode.Eight,
	["9"] = Enum.KeyCode.Nine,
}
local KA = {
	spacebar = Enum.KeyCode.Space, lshift = Enum.KeyCode.LeftShift,
	rshift = Enum.KeyCode.RightShift, lctrl = Enum.KeyCode.LeftControl,
	rctrl = Enum.KeyCode.RightControl, lalt = Enum.KeyCode.LeftAlt,
	ralt = Enum.KeyCode.RightAlt, esc = Enum.KeyCode.Escape,
	enter = Enum.KeyCode.Return, backtick = Enum.KeyCode.Backquote,
}

-- reverse name map (for the key readout in the UI)
local RN = {}
for _, kc in ipairs(Enum.KeyCode:GetEnumItems()) do RN[kc] = kc.Name end
for n, kc in pairs(DA) do RN[kc] = n end
for n, kc in pairs(KA) do RN[kc] = n end

local function ek(s, d)
	local n = norm(s)
	return DA[n] or KA[n] or KN[n] or d or Enum.KeyCode.Unknown
end

local function lc(l)
	local f = you:FindFirstChild(LF[l])
	local v = f and f:FindFirstChild("LaneViewport")
	return v and v:FindFirstChild("LaneContent")
end

local function nc(l)
	local c = lc(l)
	return c and c:FindFirstChild("NotesContainer")
end

local function is4()
	return nc("L2") ~= nil or nc("R2") ~= nil
end

-- ===== Cached bindings (refreshed only when the keybinds UI changes) =====
local KeysDirty = true
local CachedKeys = {}

local function refreshKeys()
	if not binds or not binds.Parent then
		KeysDirty = false -- keybinds UI gone/not built yet: keep last-known keys
		return
	end
	local four = is4()
	local f4 = four and binds:FindFirstChild("4Key")
	local f2 = (not four) and binds:FindFirstChild("Frame")
	local m4 = { L2 = "4KL2", L = "4KL", R = "4KR", R2 = "4KR2" }
	local m2 = { L = "Z", R = "X" }
	local d4 = { L2 = Enum.KeyCode.D, L = Enum.KeyCode.F, R = Enum.KeyCode.J, R2 = Enum.KeyCode.K }
	local d2 = { L = Enum.KeyCode.Z, R = Enum.KeyCode.X }
	local out = {}
	for _, l in ipairs({ "L2", "L", "R", "R2" }) do
		local def = (four and d4[l]) or d2[l]
		local f = (four and f4) or ((not four) and f2)
		local nm = (four and m4[l]) or m2[l]   -- nil for L2/R2 in 2K mode -> handled below
		local b = f and nm and f:FindFirstChild(nm)
		out[l] = b and ek(b.Text, def) or (def or Enum.KeyCode.Unknown)
	end
	CachedKeys = out
	AP.FourKey = four ~= false
	KeysDirty = false
end

local function key(l)
	if KeysDirty then refreshKeys() end
	return CachedKeys[l]
end

local function sig()
	return { L2 = lc("L2"), L = lc("L"), R = lc("R"), R2 = lc("R2") }
end

local function same(s)
	local n = sig()
	return s and s.L2 == n.L2 and s.L == n.L and s.R == n.R and s.R2 == n.R2
end

local function info(f)
	local g = debug and debug.getinfo or getinfo
	if type(g) ~= "function" then return end
	local o, v = pcall(g, f)
	if o and type(v) == "table" then return v end
end

local function ups(f)
	local g = debug and debug.getupvalues or getupvalues
	if type(g) ~= "function" then return end
	local o, v = pcall(g, f)
	if o and type(v) == "table" then return v end
end

local function src(i)
	local s = i and (i.source or i.short_src or i.Source)
	return type(s) == "string" and s:find("GAMEFRAME.YOU.LocalScript", 1, true) ~= nil
end

local function livecount(u)
	local n = 0
	if type(u) ~= "table" then return 0 end
	for _, a in pairs(u) do
		if type(a) == "table" then
			for _, v in pairs(a) do
				if typeof(v) == "Instance" and v.Name == "LaneContent" then
					local o, x = pcall(v.IsDescendantOf, v, you)
					if o and x then n += 1 end
				end
			end
		end
	end
	return n
end

local function has(u, x)
	if type(u) == "table" then
		for _, v in pairs(u) do
			if v == x then return true end
		end
	end
	return false
end

local function firsttab(u)
	if type(u) == "table" then
		for _, v in pairs(u) do
			if type(v) == "table" then return v end
		end
	end
end

local function refreshPC()
	if type(getgc) ~= "function" then return false end
	local o, g = pcall(getgc, true)
	if not o or type(g) ~= "table" then o, g = pcall(getgc) end
	if not o or type(g) ~= "table" then return false end

	local hit, best = nil, 0
	for _, f in ipairs(g) do
		if type(f) == "function" then
			local i = info(f)
			if i and src(i) and (i.name or i.Name) == "hitLane" then
				local c = livecount(ups(f))
				if c > best then best, hit = c, f end
			end
		end
	end
	if not hit or best < 2 then return false end

	local press, km
	for _, f in ipairs(g) do
		if type(f) == "function" then
			local i = info(f)
			local a = i and (i.numparams or i.nparams or i.Arity)
			if i and src(i) and a == 2 then
				local u = ups(f)
				if has(u, hit) then
					press, km = f, firsttab(u)
					break
				end
			end
		end
	end
	if not press or type(km) ~= "table" then return false end

	local rel
	for _, f in ipairs(g) do
		if type(f) == "function" and f ~= press then
			local i = info(f)
			local a = i and (i.numparams or i.nparams or i.Arity)
			if i and src(i) and a == 2 then
				local u = ups(f)
				if firsttab(u) == km then
					for _, v in pairs(u or {}) do
						if type(v) == "function" and v ~= hit then
							rel = f
							break
						end
					end
					if rel then break end
				end
			end
		end
	end
	if not rel then return false end

	AP.PC = { Press = press, Release = rel, Sig = sig() }
	return true
end

local function ensurePC()
	return AP.PC and same(AP.PC.Sig) or (refreshPC())
end

local function input(k, st)
	return {
		KeyCode = k,
		UserInputType = Enum.UserInputType.Keyboard,
		UserInputState = st,
		Position = Vector3.zero,
		Delta = Vector3.zero,
	}
end

local function pc(kind, l)
	if type(firesignal) ~= "function" then return false end
	local k = key(l)
	if k == Enum.KeyCode.Unknown then return false end
	for _ = 1, 2 do
		if not ensurePC() then return false end
		local be = Instance.new("BindableEvent")
		local ok2 = false
		local c = be.Event:Connect(function(q)
			local f = kind == "press" and AP.PC.Press or AP.PC.Release
			ok2 = pcall(f, q, false)
		end)
		local ok = pcall(firesignal, be.Event,
			input(k, kind == "press" and Enum.UserInputState.Begin or Enum.UserInputState.End))
		c:Disconnect()
		be:Destroy()
		if ok and ok2 then return true, k end
		AP.PC = nil
	end
	return false, k
end

local function mb(kind, l)
	if KeysDirty then refreshKeys() end
	local m = mobile:FindFirstChild(AP.FourKey and "4K" or "2K")
	local b = m and m:FindFirstChild(l)
	if not b or type(firesignal) ~= "function" then return false end
	local q = {
		UserInputType = Enum.UserInputType.MouseButton1,
		UserInputState = kind == "press" and Enum.UserInputState.Begin or Enum.UserInputState.End,
	}
	return pcall(firesignal, kind == "press" and b.InputBegan or b.InputEnded, q)
end

local function press(mode, l)
	if mode == "firesignal" then
		if UIS.KeyboardEnabled then
			return pc("press", l)
		else
			return mb("press", l), nil
		end
	end
	local k = key(l)
	if k == Enum.KeyCode.Unknown then return false end
	return pcall(VIM.SendKeyEvent, VIM, true, k, false, game), k
end

local function release(mode, l, k)
	if mode == "firesignal" then
		if UIS.KeyboardEnabled then
			return pc("release", l)
		else
			return mb("release", l)
		end
	end
	k = k or key(l)
	if not k or k == Enum.KeyCode.Unknown then return false end
	return pcall(VIM.SendKeyEvent, VIM, false, k, false, game)
end

local function cyAbs(x)
	return x.AbsolutePosition.Y + x.AbsoluteSize.Y * 0.5
end

local function relLane(l, n, t)
	local a = AP.ActiveLanes[l]
	if not a or a.Note ~= n or a.Token ~= t then return end
	AP.ActiveLanes[l] = nil
	if release(a.Mode, l, a.Key) then
		AP.Stats.Releases += 1
	else
		AP.Stats.InputFailures += 1
	end
end

local function relAll()
	local p = {}
	for l, a in pairs(AP.ActiveLanes) do
		p[#p + 1] = { l, a }
	end
	table.clear(AP.ActiveLanes)
	for _, e in ipairs(p) do
		-- FIXED: e is {lane, active}; was passing the tuple as the lane before
		pcall(release, e[2].Mode, e[1], e[2].Key)
	end
end

-- ===== Scheduler state =====
local Sched = {
	Pending = {},  -- queue of note entries; Head..n = not-yet-processed
	Head = 0,
	Releases = {}, -- delayed tap releases: { at, Mode, Lane, Key }
}

local nextHudAt = 0
local LastActivity = 0

local function anyActive()
	for _ in pairs(AP.ActiveLanes) do return true end
	return false
end

local function cancelRelease(l)
	if #Sched.Releases == 0 then return end
	local keep = {}
	for i = 1, #Sched.Releases do
		if Sched.Releases[i].Lane ~= l then keep[#keep + 1] = Sched.Releases[i] end
	end
	Sched.Releases = keep
end

local function drainReleases()
	local r = Sched.Releases
	if #r == 0 then return end
	local now = os.clock()
	local keep = {}
	for i = 1, #r do
		local x = r[i]
		if now >= x.at then
			if release(x.Mode, x.Lane, x.Key) then
				AP.Stats.Releases += 1
			else
				AP.Stats.InputFailures += 1
			end
		else
			keep[#keep + 1] = x
		end
	end
	Sched.Releases = keep
end

local function flushSched()
	-- send any pending tap releases immediately, then reset queues
	for i = 1, #Sched.Releases do
		local x = Sched.Releases[i]
		if release(x.Mode, x.Lane, x.Key) then
			AP.Stats.Releases += 1
		else
			AP.Stats.InputFailures += 1
		end
	end
	table.clear(Sched.Releases)
	table.clear(Sched.Pending)
	Sched.Head = 0
end

local function schedCompact()
	local p, h = Sched.Pending, Sched.Head
	if h < 1 then return end
	if h >= 64 and h * 2 >= #p then
		local nw = {}
		for i = h + 1, #p do
			local e = p[i]
			if e then nw[#nw + 1] = e end
		end
		Sched.Pending = nw
		Sched.Head = 0
	end
end

-- ===== Lane info cache (weak keys - containers die between songs) =====
local LaneCache = setmetatable({}, { __mode = "k" })

local function getLaneInfo(c)
	local li = LaneCache[c]
	if not li then
		local x = c and c.Parent
		local v = x and x.Parent
		local f = v and v.Parent
		local l = f and FL[f.Name]
		local h = x and x:FindFirstChild("HITPOS")
		if l and h then
			li = {
				Lane = l,
				Hit = h,
				HitY = h.AbsoluteSize.Y * 0.5,
				Win = math.max(4, h.AbsoluteSize.Y * 0.08),
				Origin = c,
			}
			LaneCache[c] = li
			AP.Stats.Lanes = math.max(AP.Stats.Lanes, #({ L2 = 1, L = 1, R = 1, R2 = 1 }))
		end
	end
	return li
end

-- note center Y (cheap path: container origin read once per frame + note's own Y)
local function cyNote(e, g)
	return g.Oy + e.N.Position.Y + e.SY * 0.5
end

-- One entry, one step. Returns true while the note still needs watching.
local function stepEntry(e, g)
	local li = LaneCache[e.C]
	if not li then return false end
	if not e.P then
		-- not pressed yet
		if e.G ~= AP.Generation or AP.Tokens[e.N] ~= e.T or e.N.Parent ~= e.C then
			if AP.Tokens[e.N] == e.T then AP.Stats.ExpiredUnpressed += 1 end
			return false
		end
		if not e.N.Visible or not e.C.Visible then return true end

		local d = cyNote(e, g) - g.Hy
		if d < -(li.Win + AP.Offset) then
			return true -- still approaching the line
		end
		if d - li.Win > AP.PastTol then
			-- far past the line and not judged yet: drop, don't spam the key
			AP.Stats.ExpiredUnpressed += 1
			return false
		end
		-- press it
		local old = AP.ActiveLanes[e.L]
		if old then relLane(e.L, old.Note, old.Token) end
		cancelRelease(e.L)
		local hold = e.N:FindFirstChild("HOLDNOTE")
		local ih = hold and hold:IsA("GuiObject") and hold.AbsoluteSize.Y > 1
		if ih then AP.Stats.HoldNotes += 1 else AP.Stats.TapNotes += 1 end
		local m = AP.Mode
		local ok, k = press(m, e.L)
		if not ok then
			AP.Stats.InputFailures += 1
			return false
		end
		AP.Stats.Presses += 1
		e.P = true
		AP.ActiveLanes[e.L] = { Note = e.N, Token = e.T, Mode = m, Key = k, Hold = ih }
		LastActivity = os.clock()
		if ih then
			e.H = hold
			return true -- keep watching for hold end
		end
		-- tap: schedule a short release instead of spawning a task
		Sched.Releases[#Sched.Releases + 1] = {
			at = os.clock() + AP.TapRelease, Mode = m, Lane = e.L, Key = k,
		}
		return false
	end
	-- already pressed (hold note): watch for the end of the hold
	local h = e.H
	if not h or not h.Parent or h.AbsoluteSize.Y <= 1 or not e.N.Visible or e.N.Parent ~= e.C then
		relLane(e.L, e.N, e.T)
		return false
	end
	return true
end

local function queue(n, c)
	if not n then return end
	if not AP.Enabled or AP.Unloaded or not n:IsA("GuiObject") or n.Name ~= "NOTE" then
		if not AP.Unloaded and n.Name == "NOTE" then
			AP.Signals += 1
			AP.LastSignalAt = os.clock()
		end
		return
	end
	local li = getLaneInfo(c)
	if not li then return end
	local t = (AP.Tokens[n] or 0) + 1
	AP.Tokens[n] = t
	AP.Stats.Notes += 1
	if t > 1 then AP.Stats.ReusedNotes += 1 end
	Sched.Pending[#Sched.Pending + 1] = {
		N = n, C = c, L = li.Lane, T = t, G = AP.Generation,
		SY = n.AbsoluteSize.Y, -- read once at spawn, notes don't resize
		H = nil, P = false,
	}
	LastActivity = os.clock()
end

local function bind(c)
	if not c or c.Name ~= "NotesContainer" or AP.Bound[c] then return end
	local l = c and c.Parent and c.Parent.Parent and c.Parent.Parent.Parent
	if not l or not FL[l.Name] then return end
	AP.Bound[c] = true
	local li = getLaneInfo(c)
	AP.Stats.Containers += 1
	AP.PC = nil
	AP.ContainerConnections[c] = c.ChildAdded:Connect(function(n)
		queue(n, c)
	end)
	if AP.Enabled then
		for _, n in ipairs(c:GetChildren()) do queue(n, c) end
	end
end

local function bindall()
	for _, l in ipairs({ "L2", "L", "R", "R2" }) do
		bind(nc(l))
	end
end

local function enabled(v)
	AP.Enabled = v == true
	AP.Generation += 1
	relAll()
	flushSched()
	LastActivity = os.clock()
	if AP.Enabled then
		if KeysDirty then refreshKeys() end
		bindall()
		for _, l in ipairs({ "L2", "L", "R", "R2" }) do
			local c = nc(l)
			if c then
				for _, n in ipairs(c:GetChildren()) do queue(n, c) end
			end
		end
	end
	if AP.UI and type(AP.UI.Sync) == "function" then AP.UI.Sync() end
end

AP.SetEnabled = enabled
AP.SetMode = function(v)
	if v == "firesignal" and not HAS_FIRESIGNAL then v = "Virtual Input" end
	if v == "Virtual Input" or (v == "firesignal" and HAS_FIRESIGNAL) then
		relAll()
		flushSched()
		AP.Mode = v
		AP.PC = nil
	end
end

-- ===== The scheduler task (ONE task, not one per note) =====
local function schedTick()
	if AP.Enabled and not AP.Unloaded then
		-- frame geometry: one absolute read per lane, shared by all notes
		local geom = {}
		for _, li in pairs(LaneCache) do
			local c, h = li.Origin, li.Hit
			if c and c.Parent and h and h.Parent then
				geom[li.Lane] = { Oy = c.AbsolutePosition.Y, Hy = h.AbsolutePosition.Y + li.HitY }
			end
		end
		local budget = AP.MaxPerFrame
		local p, hh = Sched.Pending, Sched.Head
		while hh < #p and budget > 0 do
			hh += 1
			budget -= 1
			local e = p[hh]
			if e then
				local g = geom[e.L]
				if not g or not stepEntry(e, g) then
					p[hh] = nil
				end
			end
		end
		Sched.Head = hh
		schedCompact()
		drainReleases()
	end
	-- Auto mode
	if AP.Auto and not AP.Unloaded then
		local now = os.clock()
		if not AP.Enabled then
			if AP.Signals > 0 and now - AP.LastSignalAt <= 0.75 then
				enabled(true)
				LastActivity = now
			end
		elseif now - LastActivity > AP.AutoIdle and not anyActive() then
			enabled(false)
		end
	end
	-- HUD throttle (max ~2 updates/sec)
	if AP.UI and AP.UI.HudVisible then
		local now = os.clock()
		if now >= nextHudAt then
			nextHudAt = now + 0.5
			AP.UI.UpdateHud()
		end
	end
end

task.spawn(function()
	while not AP.Unloaded do
		RunService.RenderStepped:Wait()
		schedTick()
	end
end)

cn(you.DescendantAdded, function(x)
	if x.Name == "NotesContainer" then
		bind(x)
		KeysDirty = true
	elseif FL[x.Name] then
		AP.PC = nil
		KeysDirty = true
	end
end)

cn(you.DescendantRemoving, function(x)
	if x.Name == "NotesContainer" or FL[x.Name] then
		AP.PC = nil
		KeysDirty = true
	end
end)

cn(binds.DescendantAdded, function() KeysDirty = true end)
cn(binds.DescendantRemoving, function() KeysDirty = true end)

refreshKeys()
bindall()

function AP.Unload()
	if AP.Unloaded then return end
	AP.Unloaded = true
	AP.Enabled = false
	AP.Generation += 1
	relAll()
	flushSched()
	for _, c in ipairs(AP.Connections) do
		pcall(c.Disconnect, c)
	end
	for c, k in pairs(AP.ContainerConnections) do
		AP.ContainerConnections[c] = nil
		pcall(k.Disconnect, k)
	end
	if AP.UI then
		pcall(AP.UI.Unload, AP.UI)
	end
	if G.DeltaRhythmAutoplayer == AP then
		G.DeltaRhythmAutoplayer = nil
	end
end

