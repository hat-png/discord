-- ===== Sliders (generalized so we can have two) =====
local ALL_SLIDERS = {}

local function makeSlider(railY, minV, maxV, getv, setv, fmt)
	local label = Instance.new("TextLabel")
	label.Size = UDim2.new(0.9, 0, 0, 16)
	label.Position = UDim2.new(0.05, 0, 0, railY - 22)
	label.BackgroundTransparency = 1
	label.TextColor3 = Color3.new(1, 1, 1)
	label.Font = Enum.Font.SourceSans
	label.TextSize = 12

	local rail = Instance.new("Frame")
	rail.Size = UDim2.new(0.9, 0, 0, 4)
	rail.Position = UDim2.new(0.05, 0, 0, railY)
	rail.BackgroundColor3 = Color3.fromRGB(80, 80, 80)
	rail.BorderSizePixel = 0

	local thumb = Instance.new("TextButton")
	thumb.Size = UDim2.fromOffset(14, 14)
	thumb.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
	thumb.Text = ""
	thumb.BorderSizePixel = 0

	local s = { Label = label, Rail = rail, Thumb = thumb, Min = minV, Max = maxV,
		Get = getv, Set = setv, Fmt = fmt, RailY = railY }

	local function update()
		local value = math.clamp(getv(), minV, maxV)
		local ratio = (value - minV) / (maxV - minV)
		thumb.Position = UDim2.new(0.05 + ratio * 0.9, -7, 0, railY - 7)
		label.Text = fmt(math.floor(value + 0.5))
	end
	s.Update = update
	update()

	label.Parent = main
	rail.Parent = main
	thumb.Parent = main
	ALL_SLIDERS[#ALL_SLIDERS + 1] = s
	return s
end

