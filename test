function UI.UpdateHud()
	local s = AP.Stats
	local hit, miss = s.Presses, s.ExpiredUnpressed
	local acc = (hit + miss) > 0 and math.floor(100 * hit / (hit + miss) + 0.5) or 100
	hudL1.Text = string.format("Notes %d   Presses %d", s.Notes, hit)
	hudL2.Text = string.format("Miss %d   Acc %d%%", miss, acc)
	hudL3.Text = string.format("Fail %d   Holds %d", s.InputFailures, s.HoldNotes)
	if KeysDirty then refreshKeys() end
	local out = {}
	for _, l in ipairs({ "L2", "L", "R", "R2" }) do
		local k = key(l)
		if k ~= Enum.KeyCode.Unknown then out[#out + 1] = l .. ":" .. (RN[k] or "?") end
	end
	keysLabel.Text = table.concat(out, "  ")
end

function UI.Sync()
