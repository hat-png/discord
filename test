local UI = {}
AP.UI = UI

local gui = Instance.new("ScreenGui")
gui.Name = "DeltaRhythmAutoplayerUI"
gui.ResetOnSpawn = false
gui.Parent = lp:WaitForChild("PlayerGui")

local uiConnections = {}
local function uiConnect(s, f)
	local c = s:Connect(f)
	uiConnections[#uiConnections + 1] = c
	return c
end

local function clampOnScreen(target, x, y)
	local vp = gui.AbsoluteSize
	local size = target.AbsoluteSize
	local maxX = math.max(0, vp.X - size.X)
	local maxY = math.max(0, vp.Y - size.Y)
	target.Position = UDim2.fromOffset(math.clamp(x, 0, maxX), math.clamp(y, 0, maxY))
end

local function isOver(g, pos)
	local p = g.AbsolutePosition
	local s = g.AbsoluteSize
	return pos.X >= p.X and pos.X <= p.X + s.X and pos.Y >= p.Y and pos.Y <= p.Y + s.Y
end

