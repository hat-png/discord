	toggleBtn.Text = on and "Enabled: On" or "Enabled: Off"
	toggleBtn.BackgroundColor3 = on and Color3.fromRGB(0, 150, 0) or Color3.fromRGB(70, 70, 70)
	autoBtn.Text = AP.Auto and "Auto: On" or "Auto: Off"
	autoBtn.BackgroundColor3 = AP.Auto and Color3.fromRGB(0, 120, 170) or Color3.fromRGB(60, 60, 60)
	hudBtn.Text = hud.Visible and "HUD: On" or "HUD: Off"
end

-- ===== Lean drag system =====
local drag = nil
local press = nil
local DragSlider = nil
local sliderConn = nil

local function pos2(o)
	return Vector2.new(o.Position.X, o.Position.Y)
end

local function sliderSetFromX(s, absX)
	local x = absX - s.Rail.AbsolutePosition.X
	local width = s.Rail.AbsoluteSize.X
	if width > 0 then
		local ratio = math.clamp(x / width, 0, 1)
		local value = s.Min + ratio * (s.Max - s.Min)
		s.Set(value)
		s.Update()
	end
end

local function moveDrag(absPos)
	if drag then
		if press then
			if math.abs(absPos.X - press.X) > 6 or math.abs(absPos.Y - press.Y) > 6 then
				press.Moved = true
			end
		end
		clampOnScreen(drag.Target, absPos.X - drag.Offset.X, absPos.Y - drag.Offset.Y)
	elseif DragSlider then
		sliderSetFromX(DragSlider, absPos.X)
	end
end

local function beginDrag(target, absPos, isOpenButton, inputObj)
	if drag then return end
	drag = { Target = target, Offset = absPos - target.AbsolutePosition, Conn = nil }
	if isOpenButton then
		press = { X = absPos.X, Y = absPos.Y, Moved = false }
	end
	if inputObj then
		drag.Conn = inputObj.Changed:Connect(function(prop)
			if prop == "Position" then
				moveDrag(pos2(inputObj))
			end
		end)
	end
end

local function stopDrag()
	if press and not press.Moved then
		showPanel()
	end
	press = nil
	if drag then
		if drag.Conn then pcall(drag.Conn.Disconnect, drag.Conn) end
		drag = nil
	end
	if sliderConn then
		pcall(sliderConn.Disconnect, sliderConn)
		sliderConn = nil
	end
	DragSlider = nil
end

local dragExclusions = { closeBtn, toggleBtn, autoBtn, modeBtn, hudBtn, resetBtn }
for _, s in ipairs(ALL_SLIDERS) do
	dragExclusions[#dragExclusions + 1] = s.Thumb
end

local function overExcluded(pos)
	for _, g in ipairs(dragExclusions) do
		if g and g.Visible and isOver(g, pos) then return true end
	end
	return false
end

local function tryStart(absPos, inputObj)
	if drag or DragSlider then return end
	if openBtn.Visible and isOver(openBtn, absPos) then
		beginDrag(openBtn, absPos, true, inputObj)
	elseif main.Visible and isOver(main, absPos) and not overExcluded(absPos) then
		beginDrag(main, absPos, false, inputObj)
	elseif main.Visible then
		for _, s in ipairs(ALL_SLIDERS) do
			if isOver(s.Thumb, absPos) then
				DragSlider = s
				if inputObj then
					sliderConn = inputObj.Changed:Connect(function(prop)
						if prop == "Position" then
							moveDrag(pos2(inputObj))
						end
					end)
				end
				return
			end
		end
	end
end

uiConnect(UIS.InputBegan, function(input)
	local it = input.UserInputType
	if it == Enum.UserInputType.MouseButton1 or it == Enum.UserInputType.Touch then
		tryStart(pos2(input), input)
	end
end)

uiConnect(UIS.InputChanged, function(input)
	local it = input.UserInputType
	if it == Enum.UserInputType.MouseMovement or it == Enum.UserInputType.Touch then
		if drag or DragSlider then
			moveDrag(pos2(input))
		end
	end
end)

uiConnect(UIS.InputEnded, function(input)
	local it = input.UserInputType
	if it == Enum.UserInputType.MouseButton1 or it == Enum.UserInputType.Touch then
		stopDrag()
	end
end)

openBtn.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		tryStart(openBtn.AbsolutePosition + pos2(input), input)
	end
end)

openBtn.InputEnded:Connect(function(input)
